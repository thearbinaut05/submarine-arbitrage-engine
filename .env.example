# FlashArb Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE (for Edge Functions)
# ============================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# SMART CONTRACTS (Deployed Addresses)
# ============================================
# Ethereum Mainnet
VITE_FLASH_ARB_ETHEREUM=
VITE_GASLESS_RELAYER_ETHEREUM=
VITE_POSITION_REBALANCER_ETHEREUM=

# Arbitrum
VITE_FLASH_ARB_ARBITRUM=
VITE_GASLESS_RELAYER_ARBITRUM=
VITE_POSITION_REBALANCER_ARBITRUM=

# Polygon
VITE_FLASH_ARB_POLYGON=
VITE_GASLESS_RELAYER_POLYGON=
VITE_POSITION_REBALANCER_POLYGON=

# BSC
VITE_FLASH_ARB_BSC=
VITE_GASLESS_RELAYER_BSC=
VITE_POSITION_REBALANCER_BSC=

# ============================================
# DEPLOYMENT PRIVATE KEY (DO NOT SHARE!)
# ============================================
# For gasless deployment via Gelato, this key is used to sign transactions
# but gas is sponsored by Gelato 1Balance
DEPLOYER_PRIVATE_KEY=0xYourPrivateKeyHere

# ============================================
# GELATO RELAY (Gasless Transactions)
# ============================================
# Get API key from https://app.gelato.network/
GELATO_API_KEY=your_gelato_api_key

# ============================================
# RPC ENDPOINTS (Optional - defaults provided)
# ============================================
# Ethereum
ETHEREUM_RPC_URL=https://eth.llamarpc.com
# Alternatives:
# - https://rpc.ankr.com/eth
# - https://cloudflare-eth.com
# - https://eth.llamarpc.com (primary)

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# BSC
BSC_RPC_URL=https://bsc-dataseed.binance.org

# ============================================
# BLOCKCHAIN EXPLORER API KEYS (Optional)
# ============================================
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# ============================================
# COINMARKETCAP (For gas reporting)
# ============================================
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

