# Mainnet Deployment Environment Variables
# Copy this file to .env.mainnet and fill in the values

# =============================================================================
# RPC Endpoints (Use reliable providers like Alchemy or Infura)
# =============================================================================
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Fallback public RPCs (for development/testing only)
PUBLIC_RPC_URL=https://eth.llamarpc.com

# =============================================================================
# Wallet & Deployment
# =============================================================================
# Private key for deployment (use a fresh wallet, never use main wallet)
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# =============================================================================
# Etherscan API Keys (for contract verification)
# =============================================================================
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# =============================================================================
# Gelato Relay Configuration
# =============================================================================
# Get your API key from https://relay.gelato.network/
GELATO_API_KEY=your_gelato_api_key

# Gelato Relayer addresses (these are the official relay contracts)
GELATO_RELAYER_ETHEREUM=0xaBcC9b596420A9E9172FD5938620E265a0f9Df92
GELATO_RELAYER_ARBITRUM=0xaBcC9b596420A9E9172FD5938620E265a0f9Df92
GELATO_RELAYER_POLYGON=0xaBcC9b596420A9E9172FD5938620E265a0f9Df92

# =============================================================================
# Supabase Configuration
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# Aave V3 Pool Addresses (Mainnet)
# =============================================================================
AAVE_V3_POOL_ETHEREUM=0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
AAVE_V3_POOL_ARBITRUM=0x794a61358D6845594F94dc1DB02A252b5b4814aD
AAVE_V3_POOL_POLYGON=0x794a61358D6845594F94dc1DB02A252b5b4814aD

# =============================================================================
# DEX Router Addresses (Mainnet)
# =============================================================================
UNISWAP_V3_ROUTER_ETHEREUM=0xE592427A0AEce92De3Edee1F18E0157C05861564
SUSHISWAP_ROUTER_ETHEREUM=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
QUICKSWAP_ROUTER_POLYGON=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff

# =============================================================================
# FlashArb Contract Addresses (Deployed addresses will be added here)
# =============================================================================
VITE_FLASH_ARB_ADDRESS=
VITE_GASLESS_RELAYER_ADDRESS=
VITE_POSITION_REBALANCER_ADDRESS=

# =============================================================================
# Scanner Configuration
# =============================================================================
# Minimum profit threshold (percentage)
SCANNER_MIN_PROFIT_PERCENT=0.1
# Minimum profit in USD
SCANNER_MIN_PROFIT_USD=10
# Scan interval in milliseconds
SCANNER_INTERVAL_MS=5000

# =============================================================================
# Gas Settings
# =============================================================================
# Default gas limit for arbitrage transactions
DEFAULT_GAS_LIMIT=500000
# Maximum gas price in Gwei
MAX_GAS_PRICE_GWEI=100
# Slippage tolerance (percentage)
SLIPPAGE_TOLERANCE=0.5

# =============================================================================
# Optional: Monitoring & Analytics
# =============================================================================
# CoinMarketCap API key for gas estimation in USD
COINMARKETCAP_API_KEY=
# Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

