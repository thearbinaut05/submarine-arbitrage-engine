# ⚠️ NEVER COMMIT YOUR ACTUAL .env FILE!
# Copy this to .env and fill in your values

# Deployer wallet private key (with 0x prefix)
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# RPC URLs (get free ones from Alchemy, Infura, or use public RPCs)
MAINNET_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# Testnet RPCs
GOERLI_RPC_URL=https://rpc.ankr.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Block explorer API keys for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# Gelato Relay for gasless transactions
GELATO_API_KEY=your_gelato_api_key

# Gas reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
